{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homeless-atlas",
  "main": "scripts/deploy-worker.js",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
